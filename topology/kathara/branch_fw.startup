#!/bin/sh
# startup for branch_fw
ip link set eth0 up
ip addr add 203.0.113.6/30 dev eth0
ip link set eth1 up
ip addr add 10.255.255.6/30 dev eth1
ip link set eth2 up
ip addr add 10.70.10.1/24 dev eth2
ip link set eth3 up
ip addr add 10.70.20.1/24 dev eth3
ip route add default via 203.0.113.5
# --- iptables baseline: permissive 'before refinement' state ---
iptables -P FORWARD ACCEPT
iptables -P INPUT ACCEPT
iptables -P OUTPUT ACCEPT
# === provided ruleset (normalized: CRLF stripped, branch subnet corrected, arg order canonicalized) ===
iptables -F FORWARD   # idempotency guard: re-run flushes before re-adding
iptables -A FORWARD -m conntrack --ctstate NEW -s 80.71.158.0/24 -d 10.70.10.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.70.10.0/24 -d 10.40.20.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.70.10.0/24 -d 10.20.20.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.70.10.0/24 -d 10.10.10.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.70.10.0/24 -d 10.10.20.0/24 -j DROP
# === end provided ruleset ===
# SNAT (perimeter NAT)
iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
# --- start FRR (OSPF) ---
mkdir -p /etc/frr
cp /etc/frr/daemons.lab /etc/frr/daemons 2>/dev/null || true
cp /etc/frr/frr.conf.lab /etc/frr/frr.conf 2>/dev/null || true
(/usr/lib/frr/frrinit.sh restart >/dev/null 2>&1) || (service frr restart >/dev/null 2>&1) || (/etc/init.d/frr restart >/dev/null 2>&1) || true

# RefinementEngine lifecycle device-job agent
mkdir -p /shared/branch_fw/inbox /shared/branch_fw/done
DEVICE=branch_fw sh /shared/device_applier.sh >> /shared/branch_fw/agent.log 2>&1 < /dev/null &
