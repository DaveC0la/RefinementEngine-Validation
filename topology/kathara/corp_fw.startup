#!/bin/sh
# startup for corp_fw
ip link set eth0 up
ip addr add 10.1.2.2/30 dev eth0
ip link set eth1 up
ip addr add 10.1.2.6/30 dev eth1
ip link set eth2 up
ip addr add 10.20.10.1/24 dev eth2
ip link set eth3 up
ip addr add 10.20.20.1/24 dev eth3
# --- iptables baseline: permissive 'before refinement' state ---
iptables -P FORWARD ACCEPT
iptables -P INPUT ACCEPT
iptables -P OUTPUT ACCEPT
# === provided ruleset (normalized: CRLF stripped, branch subnet corrected, arg order canonicalized) ===
iptables -F FORWARD   # idempotency guard: re-run flushes before re-adding
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.20.10.0/24 -d 10.40.20.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.20.20.0/24 -d 10.40.20.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.20.10.0/24 -d 10.20.20.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.20.10.0/24 -d 10.10.10.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.20.20.0/24 -d 10.10.10.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.20.10.0/24 -d 10.10.20.0/24 -j DROP
iptables -A FORWARD -m conntrack --ctstate NEW -s 10.20.20.0/24 -d 10.10.20.0/24 -j DROP
# === end provided ruleset ===
# --- start FRR (OSPF) ---
mkdir -p /etc/frr
cp /etc/frr/daemons.lab /etc/frr/daemons 2>/dev/null || true
cp /etc/frr/frr.conf.lab /etc/frr/frr.conf 2>/dev/null || true
(/usr/lib/frr/frrinit.sh restart >/dev/null 2>&1) || (service frr restart >/dev/null 2>&1) || (/etc/init.d/frr restart >/dev/null 2>&1) || true

# RefinementEngine lifecycle device-job agent
mkdir -p /shared/corp_fw/inbox /shared/corp_fw/done
DEVICE=corp_fw sh /shared/device_applier.sh >> /shared/corp_fw/agent.log 2>&1 < /dev/null &
