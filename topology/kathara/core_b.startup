#!/bin/sh
# startup for core_b
ip link set eth0 up
ip addr add 10.0.0.6/30 dev eth0
ip link set eth1 up
ip addr add 10.0.0.10/30 dev eth1
ip link set eth2 up
ip addr add 10.1.1.5/30 dev eth2
ip link set eth3 up
ip addr add 10.1.2.5/30 dev eth3
ip link set eth4 up
ip addr add 10.1.3.5/30 dev eth4
ip link set eth5 up
ip addr add 10.1.4.5/30 dev eth5
ip link set eth6 up
ip addr add 10.1.5.5/30 dev eth6
# --- iptables baseline: permissive 'before refinement' state ---
iptables -P FORWARD ACCEPT
iptables -P INPUT ACCEPT
iptables -P OUTPUT ACCEPT
# --- start FRR (OSPF) ---
mkdir -p /etc/frr
cp /etc/frr/daemons.lab /etc/frr/daemons 2>/dev/null || true
cp /etc/frr/frr.conf.lab /etc/frr/frr.conf 2>/dev/null || true
(/usr/lib/frr/frrinit.sh restart >/dev/null 2>&1) || (service frr restart >/dev/null 2>&1) || (/etc/init.d/frr restart >/dev/null 2>&1) || true
