frr version 8
frr defaults traditional
hostname core_b
no ipv6 forwarding
!
router ospf
 network 10.0.0.4/30 area 0
 network 10.0.0.8/30 area 0
 network 10.1.1.4/30 area 0
 network 10.1.2.4/30 area 0
 network 10.1.3.4/30 area 0
 network 10.1.4.4/30 area 0
 network 10.1.5.4/30 area 0
 redistribute connected
!
line vty
!
