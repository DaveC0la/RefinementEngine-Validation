#!/bin/sh
# startup for internal_app
ip link set eth0 up
ip addr add 10.40.10.10/24 dev eth0
ip route add default via 10.40.10.1
# --- start Apache web server ---
mkdir -p /var/www/html
echo '<h1>internal_app: app.internal.acme-corp.example</h1>' > /var/www/html/index.html
# --- planted malicious endpoint (URLhaus-style web IoC placeholder) ---
mkdir -p /var/www/html/malicious/internal
echo '<h1>internal_app: PLANTED malicious resource (/malicious/internal/path)</h1>' > /var/www/html/malicious/internal/path
(service apache2 restart >/dev/null 2>&1) || (apachectl restart >/dev/null 2>&1) || true
