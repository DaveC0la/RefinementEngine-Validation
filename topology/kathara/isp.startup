#!/bin/sh
# startup for isp
ip link set eth0 up
ip addr add 80.71.158.1/24 dev eth0
ip link set eth1 up
ip addr add 203.0.113.1/30 dev eth1
ip link set eth2 up
ip addr add 203.0.113.5/30 dev eth2
# --- iptables baseline: permissive 'before refinement' state ---
iptables -P FORWARD ACCEPT
iptables -P INPUT ACCEPT
iptables -P OUTPUT ACCEPT
